{
    // Extension code under src/. webextension-toolbox's ts-loader compiles and
    // type-checks it during `pnpm build:*`; `pnpm typecheck` checks it standalone.
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["chrome"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "sourceMap": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"]
}
