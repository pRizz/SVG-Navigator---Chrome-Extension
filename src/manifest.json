{
    "name": "SVG Navigator",
    "short_name": "SVG Nav",
    "description": "Adds infinite zoom and panning to SVG files",
    "version": "2.13",
    "icons": {
        "16": "icon_16.png",
        "48": "icon_48.png",
        "128": "icon_128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "ftp://*/*",
                "file://*/*",
                "http://*/*",
                "https://*/*"
            ],
            "js": ["js/svgNavigator.js"],
            "css": ["css/svgNavigator.css"]
        }
    ],
    "manifest_version": 3,
    "action": {
        "default_popup": "options/index.html",
        "default_title": "SVG Navigator",
        "default_icon": {
            "16": "icon_16.png",
            "48": "icon_48.png"
        }
    },
    "permissions": [
        "storage"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "svg-navigator@prizzventuresllc.com",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}
